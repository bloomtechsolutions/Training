# Set by the Vercel Prisma Postgres integration when you connect the database:
DATABASE_URL=
# Password for the built-in "admin" sign-in (required):
ADMIN_PASSWORD=
# true = one-tap demo sign-in for participant/trainer/leadership personas and the demo clock. Turn OFF for real events.
DEMO_MODE=false
# false = start with the event, agenda and content only (no fictional participants). Default true.
SEED_DEMO_DATA=true
# Optional: Vercel Blob store token for photo and slide uploads (otherwise images are stored in the database).
BLOB_READ_WRITE_TOKEN=
# Optional fixed secrets (otherwise generated once and stored in the database):
SESSION_SECRET=
QR_SECRET=
